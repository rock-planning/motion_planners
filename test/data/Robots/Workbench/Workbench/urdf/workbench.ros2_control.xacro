<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="EURISE_workbench_ros2_control" params="name prefix mock_type
    initial_positions:=${dict(link_1_joint=0.0,link_2_joint=0.0,link_3_joint=0.0)}">

    <ros2_control name="${name}" type="system" mock_type="${mock_type}">

      <xacro:if value="${mock_type == 'generic_system'}">
        <hardware>
            <plugin>mock_components/GenericSystem</plugin>
        </hardware>
      </xacro:if>
      <xacro:unless value="${mock_type == 'generic_system'}">
        <hardware>
          <plugin>webots_custom_ros2_control::Ros2ControlSystem</plugin>
        </hardware>
      </xacro:unless>

      <joint name="${prefix}_link_1_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="initial_position">${initial_positions['link_1_joint']}</param>  <!-- initial position for the FakeSystem -->
      </joint>
      <joint name="${prefix}_link_2_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="initial_position">${initial_positions['link_2_joint']}</param>  <!-- initial position for the FakeSystem -->
      </joint>
      <joint name="${prefix}_link_3_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="initial_position">${initial_positions['link_3_joint']}</param>  <!-- initial position for the FakeSystem -->
      </joint>

    </ros2_control>

  </xacro:macro>

</robot>
