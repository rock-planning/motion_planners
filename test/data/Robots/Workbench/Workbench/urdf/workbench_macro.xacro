<?xml version="1.0" ?>
<robot name="Workbench" xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="Workbench" params="robot_name parent_name *origin_wrt_base">

    <xacro:property name="prefix" value="${robot_name}"/>

    <!-- joint between parent and link_0 -->
    <joint name="${prefix}_base_joint" type="fixed">
      <xacro:insert_block name="origin_wrt_base"/>
      <parent link="${parent_name}"/>
      <child link="${prefix}_link_0"/>
    </joint>

    <!-- links declaration -->
    <link name="${prefix}_link_0">
      <visual>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseWorkbench/meshes/v_wb_link_0.dae"/>
        </geometry>
        <material name="Grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseWorkbench/meshes/v_wb_link_0.dae"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_link_1">
      <visual>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseWorkbench/meshes/v_wb_link_1.dae"/>
        </geometry>
        <material name="LightGrey">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseWorkbench/meshes/v_wb_link_1.dae"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_link_2">
      <visual>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseWorkbench/meshes/v_wb_link_2.dae"/>
        </geometry>
        <material name="LightGrey"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseWorkbench/meshes/b_wb_link_2.dae"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_link_3">
      <visual>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseWorkbench/meshes/v_wb_link_3.dae"/>
        </geometry>
        <material name="LightGrey"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseWorkbench/meshes/b_wb_link_3.dae"/>
        </geometry>
      </collision>
    </link>

    <!-- joints declaration -->
    <joint name="${prefix}_link_1_joint" type="revolute">
      <parent link="${prefix}_link_0"/>
      <child link="${prefix}_link_1"/>
      <axis xyz="0 0 1"/>
      <limit effort="50" lower="-3.14149" upper="3.14149" velocity="1.5708"/>
      <origin xyz="0 0 0.129" rpy="0 0 0"/>
    </joint>

    <joint name="${prefix}_link_2_joint" type="revolute">
      <parent link="${prefix}_link_1"/>
      <child link="${prefix}_link_2"/>
      <axis xyz="1 0 0"/>
      <limit effort="50" lower="-3.14149" upper="3.14149" velocity="1.5708"/>
      <origin xyz="-0.010829 -0.000262 0.170175" rpy="0 0 0"/>
    </joint>

    <joint name="${prefix}_link_3_joint" type="revolute">
      <parent link="${prefix}_link_2"/>
      <child link="${prefix}_link_3"/>
      <axis xyz="0 0 1"/>
      <limit effort="50" lower="-3.14149" upper="3.14149" velocity="1.5708"/>
      <origin xyz="0.01617 0.000222 0.177032" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
