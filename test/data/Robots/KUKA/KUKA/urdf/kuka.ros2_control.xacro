<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="kuka_ros2_control" params="name prefix
    initial_positions:=${dict(joint_0=0.0,joint_1=0.0,joint_2=0.0,joint_3=0.0,joint_4=0.0,joint_5=0.0,joint_6=0.0)}">

    <ros2_control name="${name}" type="system">

      <hardware>
        <plugin>webots_custom_ros2_control::Ros2ControlSystem</plugin>
      </hardware>
      <joint name="${prefix}_joint_0">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="initial_position">${initial_positions['joint_0']}</param>  <!-- initial position for the FakeSystem -->
      </joint>
      <joint name="${prefix}_joint_1">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="initial_position">${initial_positions['joint_1']}</param>  <!-- initial position for the FakeSystem -->
      </joint>
      <joint name="${prefix}_joint_2">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="initial_position">${initial_positions['joint_2']}</param>  <!-- initial position for the FakeSystem -->
      </joint>
      <joint name="${prefix}_joint_3">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="initial_position">${initial_positions['joint_3']}</param>  <!-- initial position for the FakeSystem -->
      </joint>
      <joint name="${prefix}_joint_4">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="initial_position">${initial_positions['joint_4']}</param>  <!-- initial position for the FakeSystem -->
      </joint>
      <joint name="${prefix}_joint_5">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="initial_position">${initial_positions['joint_5']}</param>  <!-- initial position for the FakeSystem -->
      </joint>
      <joint name="${prefix}_joint_6">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="initial_position">${initial_positions['joint_6']}</param>  <!-- initial position for the FakeSystem -->
      </joint>

    </ros2_control>

  </xacro:macro>

</robot>
