<?xml version="1.0"?>
<robot name="iiwa14" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Simplified Kuka for Webots -->

  <webots>
    <plugin type="webots_custom_ros2_control::Ros2Control" />
  </webots>

  <!--Import the lbr iiwa macro -->
  <xacro:include filename="$(find simulation)/protos/Kuka/urdf/iiwa14_macro.xacro"/>

  <xacro:arg name="robot_name" default="iiwa14"/>

  <!-- Import Rviz colors -->
  <xacro:include filename="$(find simulation)/protos/Kuka/urdf/materials.xacro" />

  <!-- Inport the ros control macro -->
  <xacro:include filename="$(find simulation)/protos/Kuka/urdf/kuka.ros2_control.xacro" />

  <!-- Base link -->
  <link name="$(arg robot_name)_base_link"/>

  <!--iiwa-->
  <xacro:iiwa14 prefix="$(arg robot_name)" parent="$(arg robot_name)_base_link">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:iiwa14>

  <!-- ros2 control instance -->
  <xacro:kuka_ros2_control
    name="WebotsControl"
    prefix="$(arg robot_name)"
  />

</robot>
