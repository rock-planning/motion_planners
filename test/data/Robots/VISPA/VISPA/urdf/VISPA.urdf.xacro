<?xml version="1.0"?>
<robot name="EURISE_VISPA" xmlns:xacro="http://wiki.ros.org/xacro">
  <!-- Simplified VISPA for Webots -->

  <webots>
    <plugin type="webots_custom_ros2_control::Ros2Control" />
  </webots>

  <!-- VISPA robot -->
  <xacro:include filename="$(find simulation)/protos/EURISE/EuriseVISPA/urdf/VISPA_macro.xacro" />

  <!-- Define robot constants -->
  <xacro:arg name="arm_name" default="vispa"/>
  <xacro:arg name="arm_origin_xyz" default="0 0 0"/>
  <xacro:arg name="arm_origin_rpy" default="0 0 0"/>

  <!-- Mock components -->
  <xacro:arg name="mock_type" default="webots"/>

  <!-- Fixed World -->
  <link name="$(arg arm_name)_base_link"/>

  <!-- Arm -->
  <xacro:VISPA robot_name="$(arg arm_name)" parent_name="$(arg arm_name)_base_link">
    <origin xyz="$(arg arm_origin_xyz)" rpy="$(arg arm_origin_rpy)" />
  </xacro:VISPA>

  <!-- ros2 control include -->
  <xacro:include filename="$(find simulation)/protos/EURISE/EuriseVISPA/urdf/VISPA.ros2_control.xacro" />
  <!-- ros2 control instance -->
  <xacro:EURISE_VISPA_ros2_control name="WebotsControl" prefix="$(arg arm_name)" mock_type="$(arg mock_type)" />

</robot>
