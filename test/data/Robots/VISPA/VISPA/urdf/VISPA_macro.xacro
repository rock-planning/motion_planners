<?xml version="1.0" ?>
<robot name="VISPA" xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="VISPA" params="robot_name parent_name *origin_wrt_base">

    <xacro:property name="prefix" value="${robot_name}"/>

    <!-- joint between parent and link_0 -->
    <joint name="${prefix}_base_joint" type="fixed">
      <xacro:insert_block name="origin_wrt_base"/>
      <parent link="${parent_name}"/>
      <child link="${prefix}_link_0"/>
    </joint>

    <!-- links declaration -->
    <link name="${prefix}_link_0">
      <visual>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseVISPA/meshes/v_link_0.dae"/>
        </geometry>
        <material name="Grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseVISPA/meshes/b_link_0.dae"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1.5"/>
        <inertia ixx="0.00281845585208" ixy="0" ixz="0" iyy="0.00281883333333" iyz="0" izz="0.00379978918542"/>
        <origin xyz="0 0 0.0"/>
      </inertial>
    </link>

    <link name="${prefix}_link_1">
      <visual>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseVISPA/meshes/v_link_1.dae"/>
        </geometry>
        <material name="LightGrey">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseVISPA/meshes/b_link_1.dae"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="2.2"/>
        <inertia ixx="0.012" ixy="0" ixz="0" iyy="0.007" iyz="0.003" izz="0.008"/>
        <origin xyz="0 -0.029 -0.043"/>
      </inertial>
    </link>

    <link name="${prefix}_link_2">
      <visual>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseVISPA/meshes/v_link_2.dae"/>
        </geometry>
        <material name="LightGrey"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseVISPA/meshes/b_link_2.dae"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="3.8"/>
        <inertia ixx="0.010" ixy="0" ixz="0" iyy="0.578" iyz="0" izz="0.574"/>
        <origin xyz="0.4 0 0.142"/>
      </inertial>
    </link>

    <link name="${prefix}_link_3">
      <visual>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseVISPA/meshes/v_link_3.dae"/>
        </geometry>
        <material name="LightGrey"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseVISPA/meshes/b_link_3.dae"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="2.2"/>
        <inertia ixx="0.012" ixy="0" ixz="0" iyy="0.008" iyz="0.003" izz="0.007"/>
        <origin xyz="0 0.043 0.029"/>
      </inertial>
    </link>

    <link name="${prefix}_link_4">
      <visual>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseVISPA/meshes/v_link_4.dae"/>
        </geometry>
        <material name="LightGrey"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseVISPA/meshes/b_link_4.dae"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="3"/>
        <inertia ixx="0.199" ixy="0" ixz="0" iyy="0.193" iyz="0.01" izz="0.01"/>
        <origin xyz="0 -0.043 -0.210"/>
      </inertial>
    </link>

    <link name="${prefix}_link_5">
      <visual>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseVISPA/meshes/v_link_5.dae"/>
        </geometry>
        <material name="LightGrey"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseVISPA/meshes/b_link_5.dae"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="2.4"/>
        <inertia ixx="0.029" ixy="0" ixz="0" iyy="0.006" iyz="-0.001" izz="0.027"/>
        <origin xyz="0 0.125 -0.007"/>
      </inertial>
    </link>

    <link name="${prefix}_link_6">
      <visual>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseVISPA/meshes/v_link_6.dae"/>
        </geometry>
        <material name="White">
          <color rgba="1.0 1.0 1.0 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://simulation/protos/EURISE/EuriseVISPA/meshes/b_link_6.dae"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="3.3"/>
        <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/>
        <origin xyz="-0.002 0.003 -0.079"/>
      </inertial>
    </link>

    <link name="${prefix}_end_effector"/>

    <!-- joints declaration -->
    <joint name="${prefix}_link_1_joint" type="revolute">
      <parent link="${prefix}_link_0"/>
      <child link="${prefix}_link_1"/>
      <axis xyz="0 0 1"/>
      <limit effort="50" lower="-3.14149265359" upper="3.14149265359" velocity="1.57079632679"/>
      <origin xyz="0 0 0.081999" rpy="0 0 0"/>
    </joint>

    <joint name="${prefix}_link_2_joint" type="revolute">
      <parent link="${prefix}_link_1"/>
      <child link="${prefix}_link_2"/>
      <axis xyz="0 -1 0"/>
      <limit effort="50" lower="-3.14149265359" upper="3.14149265359" velocity="1.57079632679"/>
      <origin xyz="0.00000 -0.097168 0.097168" rpy="0 0 0"/>
    </joint>

    <joint name="${prefix}_link_3_joint" type="revolute">
      <parent link="${prefix}_link_2"/>
      <child link="${prefix}_link_3"/>
      <axis xyz="0 1 0"/>
      <limit effort="50" lower="-3.14149265359" upper="3.14149265359" velocity="1.57079632679"/>
      <origin xyz="0.000000 0.000000 0.799886" rpy="0 0 0"/>
    </joint>

    <joint name="${prefix}_link_4_joint" type="revolute">
      <parent link="${prefix}_link_3"/>
      <child link="${prefix}_link_4"/>
      <axis xyz="0 0 1"/>
      <limit effort="50" lower="-3.14149265359" upper="3.14149265359" velocity="1.57079632679"/>
      <origin xyz="0.000000 0.097168 0.097168" rpy="0 0 0"/>
    </joint>

    <joint name="${prefix}_link_5_joint" type="revolute">
      <parent link="${prefix}_link_4"/>
      <child link="${prefix}_link_5"/>
      <axis xyz="0 1 0"/>
      <limit effort="50" lower="-3.14149265359" upper="3.14149265359" velocity="1.57079632679"/>
      <origin xyz="0.000085 -0.010896 0.552458" rpy="0 0 0"/>
    </joint>

    <joint name="${prefix}_link_6_joint" type="revolute">
      <parent link="${prefix}_link_5"/>
      <child link="${prefix}_link_6"/>
      <axis xyz="0 0 1"/>
      <limit effort="50" lower="-3.14149265359" upper="3.14149265359" velocity="1.57079632679"/>
      <origin xyz="-0.000063 0.009315 0.227028" rpy="0 0 0"/>
    </joint>

    <joint name="${prefix}_end_effector_joint" type="fixed">
      <parent link="${prefix}_link_6"/>
      <child link="${prefix}_end_effector"/>
      <origin xyz="0 0 0.088" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
