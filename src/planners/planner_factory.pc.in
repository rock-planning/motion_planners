prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/lib
includedir=${prefix}/include/motion_planners/planner_factory

Name: @TARGET_NAME@
Description: @PROJECT_DESCRIPTION@
Version: @PROJECT_VERSION@
Requires: @PKGCONFIG_REQUIRES@ ompl
Libs: -L${libdir} -l@TARGET_NAME@ @PKGCONFIG_LIBS@ -lompl -lompl_wrapper
Cflags: -I${includedir} @PKGCONFIG_CFLAGS@ -I@OMPL_INCLUDE_DIRS@

